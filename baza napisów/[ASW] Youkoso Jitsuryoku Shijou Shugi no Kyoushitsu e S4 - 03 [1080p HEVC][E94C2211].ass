Comment: 0,0:02:10.08,0:02:12.08,MONSTER -  Eir Aoi [PL],,0,0,0,,OP
Comment: 0,0:02:12.08,0:02:17.04,MONSTER -  Eir Aoi [PL],,0,0,0,,Spuszczone ze smyczy monstrum
Comment: 0,0:02:13.66,0:02:17.04,MONSTER -  Eir Aoi [PL] 2,,0,0,0,,Już się na was czai
Comment: 0,0:02:17.04,0:02:18.52,MONSTER -  Eir Aoi [PL] 2,,0,0,0,,Zakrada się
Comment: 0,0:02:20.28,0:02:23.14,MONSTER -  Eir Aoi [PL],,0,0,0,,Spieprzajcie, gdzie pieprz rośnie
Comment: 0,0:02:23.56,0:02:26.14,MONSTER -  Eir Aoi [PL],,0,0,0,,Raz, dwa, trzy, baba jaga patrzy
Comment: 0,0:02:27.02,0:02:30.12,MONSTER -  Eir Aoi [PL],,0,0,0,,Oświecisz mnie, kim jest geniusz?
Comment: 0,0:02:30.14,0:02:33.62,MONSTER -  Eir Aoi [PL],,0,0,0,,To ktoś, kto nagina rzeczywistość
Comment: 0,0:02:33.62,0:02:36.52,MONSTER -  Eir Aoi [PL],,0,0,0,,Nie dokarmiajcie bestii
Comment: 0,0:02:36.52,0:02:42.70,MONSTER -  Eir Aoi [PL],,0,0,0,,Jeśli wam ręce miłe
Comment: 0,0:02:43.10,0:02:46.56,MONSTER -  Eir Aoi [PL],,0,0,0,,Każdy jest tylko pionkiem w rękach króla
Comment: 0,0:02:46.56,0:02:49.70,MONSTER -  Eir Aoi [PL],,0,0,0,,Już się czai
Comment: 0,0:02:49.74,0:02:52.94,MONSTER -  Eir Aoi [PL],,0,0,0,,I jak ci się podoba wizja przyszłości?
Comment: 0,0:02:52.94,0:02:57.42,MONSTER -  Eir Aoi [PL],,0,0,0,,Monstrum utkane ze steku kłamstw
Comment: 0,0:02:57.42,0:02:59.48,MONSTER -  Eir Aoi [PL],,0,0,0,,Potwór się czai i czai
Comment: 0,0:02:59.48,0:03:01.52,MONSTER -  Eir Aoi [PL],,0,0,0,,Dorwijcie w końcu go
Comment: 0,0:03:01.52,0:03:04.68,MONSTER -  Eir Aoi [PL],,0,0,0,,Pociągnijcie za ten zdradliwy spust
Comment: 0,0:03:04.68,0:03:05.94,MONSTER -  Eir Aoi [PL],,0,0,0,,Wciąż się czai i czai
Comment: 0,0:03:05.94,0:03:08.16,MONSTER -  Eir Aoi [PL],,0,0,0,,A wy się topicie
Comment: 0,0:03:08.16,0:03:09.94,MONSTER -  Eir Aoi [PL],,0,0,0,,W labiryncie myśli
Comment: 0,0:03:09.94,0:03:11.44,MONSTER -  Eir Aoi [PL],,0,0,0,,Otoczeni zagadkami
Comment: 0,0:03:11.44,0:03:16.50,MONSTER -  Eir Aoi [PL],,0,0,0,,W świecie prawdy i fałszu będziesz łowcą czy zwierzyną?
Comment: 0,0:03:16.50,0:03:17.82,MONSTER -  Eir Aoi [PL],,0,0,0,,Czas nagli
Comment: 0,0:03:17.82,0:03:19.22,MONSTER -  Eir Aoi [PL],,0,0,0,,Chowa się i kryje
Comment: 0,0:03:19.22,0:03:21.02,MONSTER -  Eir Aoi [PL],,0,0,0,,Pragnąc jedynie spokoju
Comment: 0,0:03:21.02,0:03:22.46,MONSTER -  Eir Aoi [PL],,0,0,0,,Czai się i czai
Comment: 0,0:03:22.46,0:03:27.04,MONSTER -  Eir Aoi [PL],,0,0,0,,O tak, nieobliczalne monstrum
Comment: 0,0:03:24.42,0:03:27.62,MONSTER -  Eir Aoi [PL] 2,,0,0,0,,Pałka, zapałka, dwa kije
Comment: 0,0:03:27.64,0:03:30.22,MONSTER -  Eir Aoi [PL] 2,,0,0,0,,Kto się nie schowa, ten kryje
Comment: 0,0:03:30.22,0:03:32.22,MONSTER -  Eir Aoi [PL],,0,0,0,,
