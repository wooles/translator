Comment: 0,0:02:10.08,0:02:12.08,MONSTER -  Eir Aoi [PL],,0,0,0,,OP
Comment: 0,0:01:52.01,0:01:56.97,MONSTER -  Eir Aoi [PL],,0,0,0,,Spuszczone ze smyczy monstrum
Comment: 0,0:01:53.59,0:01:56.97,MONSTER -  Eir Aoi [PL] 2,,0,0,0,,Już się na was czai
Comment: 0,0:01:56.97,0:01:58.47,MONSTER -  Eir Aoi [PL] 2,,0,0,0,,Zakrada się
Comment: 0,0:02:00.23,0:02:03.06,MONSTER -  Eir Aoi [PL],,0,0,0,,Spieprzajcie, gdzie pieprz rośnie
Comment: 0,0:02:03.48,0:02:06.06,MONSTER -  Eir Aoi [PL],,0,0,0,,Raz, dwa, trzy, baba jaga patrzy
Comment: 0,0:02:06.94,0:02:10.07,MONSTER -  Eir Aoi [PL],,0,0,0,,Oświecisz mnie, kim jest geniusz?
Comment: 0,0:02:10.07,0:02:13.57,MONSTER -  Eir Aoi [PL],,0,0,0,,To ktoś, kto nagina rzeczywistość
Comment: 0,0:02:13.57,0:02:16.45,MONSTER -  Eir Aoi [PL],,0,0,0,,Nie dokarmiajcie bestii
Comment: 0,0:02:16.45,0:02:22.62,MONSTER -  Eir Aoi [PL],,0,0,0,,Jeśli wam ręce miłe
Comment: 0,0:02:23.04,0:02:26.50,MONSTER -  Eir Aoi [PL],,0,0,0,,Każdy jest tylko pionkiem w rękach króla
Comment: 0,0:02:26.50,0:02:29.63,MONSTER -  Eir Aoi [PL],,0,0,0,,Już się czai
Comment: 0,0:02:29.67,0:02:32.88,MONSTER -  Eir Aoi [PL],,0,0,0,,I jak ci się podoba wizja przyszłości?
Comment: 0,0:02:32.88,0:02:37.35,MONSTER -  Eir Aoi [PL],,0,0,0,,Monstrum utkane ze steku kłamstw
Comment: 0,0:02:37.35,0:02:39.43,MONSTER -  Eir Aoi [PL],,0,0,0,,Potwór się czai i czai
Comment: 0,0:02:39.43,0:02:41.47,MONSTER -  Eir Aoi [PL],,0,0,0,,Dorwijcie w końcu go
Comment: 0,0:02:41.47,0:02:44.60,MONSTER -  Eir Aoi [PL],,0,0,0,,Pociągnijcie za ten zdradliwy spust
Comment: 0,0:02:44.60,0:02:45.90,MONSTER -  Eir Aoi [PL],,0,0,0,,Wciąż się czai i czai
Comment: 0,0:02:45.90,0:02:48.11,MONSTER -  Eir Aoi [PL],,0,0,0,,A wy się topicie
Comment: 0,0:02:48.11,0:02:49.86,MONSTER -  Eir Aoi [PL],,0,0,0,,W labiryncie myśli
Comment: 0,0:02:49.86,0:02:51.36,MONSTER -  Eir Aoi [PL],,0,0,0,,Otoczeni zagadkami
Comment: 0,0:02:51.36,0:02:56.45,MONSTER -  Eir Aoi [PL],,0,0,0,,W świecie prawdy i fałszu będziesz łowcą czy zwierzyną?
Comment: 0,0:02:56.45,0:02:57.74,MONSTER -  Eir Aoi [PL],,0,0,0,,Czas nagli
Comment: 0,0:02:57.74,0:02:59.16,MONSTER -  Eir Aoi [PL],,0,0,0,,Chowa się i kryje
Comment: 0,0:02:59.16,0:03:00.95,MONSTER -  Eir Aoi [PL],,0,0,0,,Pragnąc jedynie spokoju
Comment: 0,0:03:00.95,0:03:02.41,MONSTER -  Eir Aoi [PL],,0,0,0,,Czai się i czai
Comment: 0,0:03:02.41,0:03:06.96,MONSTER -  Eir Aoi [PL],,0,0,0,,O tak, nieobliczalne monstrum
Comment: 0,0:03:04.37,0:03:07.54,MONSTER -  Eir Aoi [PL] 2,,0,0,0,,Pałka, zapałka, dwa kije
Comment: 0,0:03:07.58,0:03:10.17,MONSTER -  Eir Aoi [PL] 2,,0,0,0,,Kto się nie schowa, ten kryje
Comment: 0,0:03:10.17,0:03:12.17,MONSTER -  Eir Aoi [PL],,0,0,0,,
