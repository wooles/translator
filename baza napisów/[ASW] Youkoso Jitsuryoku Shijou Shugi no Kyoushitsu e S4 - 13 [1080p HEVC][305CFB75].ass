Comment: 0,0:01:08.09,0:01:10.09,MONSTER -  Eir Aoi [PL],,0,0,0,,OP
Comment: 0,0:00:50.03,0:00:54.99,MONSTER -  Eir Aoi [PL],,0,0,0,,Spuszczone ze smyczy monstrum
Comment: 0,0:00:51.61,0:00:54.99,MONSTER -  Eir Aoi [PL] 2,,0,0,0,,Już się na was czai
Comment: 0,0:00:54.99,0:00:56.49,MONSTER -  Eir Aoi [PL] 2,,0,0,0,,Zakrada się
Comment: 0,0:00:58.25,0:01:01.08,MONSTER -  Eir Aoi [PL],,0,0,0,,Spieprzajcie, gdzie pieprz rośnie
Comment: 0,0:01:01.50,0:01:04.09,MONSTER -  Eir Aoi [PL],,0,0,0,,Raz, dwa, trzy, baba jaga patrzy
Comment: 0,0:01:04.96,0:01:08.09,MONSTER -  Eir Aoi [PL],,0,0,0,,Oświecisz mnie, kim jest geniusz?
Comment: 0,0:01:08.09,0:01:11.59,MONSTER -  Eir Aoi [PL],,0,0,0,,To ktoś, kto nagina rzeczywistość
Comment: 0,0:01:11.59,0:01:14.47,MONSTER -  Eir Aoi [PL],,0,0,0,,Nie dokarmiajcie bestii
Comment: 0,0:01:14.47,0:01:20.64,MONSTER -  Eir Aoi [PL],,0,0,0,,Jeśli wam ręce miłe
Comment: 0,0:01:21.06,0:01:24.52,MONSTER -  Eir Aoi [PL],,0,0,0,,Każdy jest tylko pionkiem w rękach króla
Comment: 0,0:01:24.52,0:01:27.65,MONSTER -  Eir Aoi [PL],,0,0,0,,Już się czai
Comment: 0,0:01:27.69,0:01:30.90,MONSTER -  Eir Aoi [PL],,0,0,0,,I jak ci się podoba wizja przyszłości?
Comment: 0,0:01:30.90,0:01:35.37,MONSTER -  Eir Aoi [PL],,0,0,0,,Monstrum utkane ze steku kłamstw
Comment: 0,0:01:35.37,0:01:37.45,MONSTER -  Eir Aoi [PL],,0,0,0,,Potwór się czai i czai
Comment: 0,0:01:37.45,0:01:39.50,MONSTER -  Eir Aoi [PL],,0,0,0,,Dorwijcie w końcu go
Comment: 0,0:01:39.50,0:01:42.62,MONSTER -  Eir Aoi [PL],,0,0,0,,Pociągnijcie za ten zdradliwy spust
Comment: 0,0:01:42.62,0:01:43.92,MONSTER -  Eir Aoi [PL],,0,0,0,,Wciąż się czai i czai
Comment: 0,0:01:43.92,0:01:46.13,MONSTER -  Eir Aoi [PL],,0,0,0,,A wy się topicie
Comment: 0,0:01:46.13,0:01:47.88,MONSTER -  Eir Aoi [PL],,0,0,0,,W labiryncie myśli
Comment: 0,0:01:47.88,0:01:49.38,MONSTER -  Eir Aoi [PL],,0,0,0,,Otoczeni zagadkami
Comment: 0,0:01:49.38,0:01:54.47,MONSTER -  Eir Aoi [PL],,0,0,0,,W świecie prawdy i fałszu będziesz łowcą czy zwierzyną?
Comment: 0,0:01:54.47,0:01:55.76,MONSTER -  Eir Aoi [PL],,0,0,0,,Czas nagli
Comment: 0,0:01:55.76,0:01:57.18,MONSTER -  Eir Aoi [PL],,0,0,0,,Chowa się i kryje
Comment: 0,0:01:57.18,0:01:58.97,MONSTER -  Eir Aoi [PL],,0,0,0,,Pragnąc jedynie spokoju
Comment: 0,0:01:58.97,0:02:00.43,MONSTER -  Eir Aoi [PL],,0,0,0,,Czai się i czai
Comment: 0,0:02:00.43,0:02:04.98,MONSTER -  Eir Aoi [PL],,0,0,0,,O tak, nieobliczalne monstrum
Comment: 0,0:02:02.39,0:02:05.56,MONSTER -  Eir Aoi [PL] 2,,0,0,0,,Pałka, zapałka, dwa kije
Comment: 0,0:02:05.61,0:02:08.19,MONSTER -  Eir Aoi [PL] 2,,0,0,0,,Kto się nie schowa, ten kryje
