Comment: 0,0:00:37.43,0:00:40.27,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Bólem na nowo spisujemy twoje imię
Comment: 0,0:00:40.56,0:00:43.86,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Wracamy do punktu startu, by zacząć od zera
Comment: 0,0:00:43.86,0:00:47.28,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Zagubieni w pustce zakręćmy kołem losu
Comment: 0,0:00:47.28,0:00:49.40,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Niech fortuna się toczy
Comment: 0,0:00:49.40,0:00:50.74,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Znam swoją dolę
Comment: 0,0:00:50.74,0:00:53.83,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Zmienić, przekuć, odbudować, odnowić
Comment: 0,0:00:53.83,0:00:55.74,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Zapisz me imię na kartach historii
Comment: 0,0:00:55.74,0:00:56.99,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Próbuj do skutku
Comment: 0,0:00:57.45,0:01:00.29,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Za tobą skoczę nawet w ogień
Comment: 0,0:01:00.29,0:01:02.38,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Dzierż mnie w dłoni niczym broń
Comment: 0,0:01:02.38,0:01:03.63,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Aż spojrzę w oczy zgubie
Comment: 0,0:01:04.00,0:01:08.97,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Choćbyś w pył obracał się raz za razem
Comment: 0,0:01:08.97,0:01:13.68,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Wyjdź na przekór rozpaczy
Comment: 0,0:01:13.68,0:01:16.14,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Szarpnij za struny swojego życia
Comment: 0,0:01:16.14,0:01:18.64,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Nawet zapomniany przez cały świat
Comment: 0,0:01:18.64,0:01:20.35,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Echo mojego istnienia
Comment: 0,0:01:20.35,0:01:23.19,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Rozbrzmiewa wśród zgliszczy
Comment: 0,0:01:23.19,0:01:27.65,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Serce moim drogowskazem, wiodącym mnie
Comment: 0,0:01:27.65,0:01:29.19,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Zniszcz, spal, a potem scal
Comment: 0,0:01:28.40,0:01:30.19,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Prosto do celu
Comment: 0,0:01:30.19,0:01:31.28,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Zaraz zobaczysz
Comment: 0,0:01:31.28,0:01:33.49,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Aż zrobi ci się mokro
Comment: 0,0:01:33.49,0:01:34.57,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Pora na bis
Comment: 0,0:01:34.57,0:01:36.45,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Stojąc po kolana w piasku
Comment: 0,0:01:36.45,0:01:37.83,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Właśnie teraz
Comment: 0,0:01:37.83,0:01:39.87,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Zawołaj mnie, bo pora na kurtynę
Comment: 0,0:01:39.87,0:01:40.41,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Tylko patrz
Comment: 0,0:01:40.41,0:01:42.08,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Dostaniesz w kość jak nikt inny
Comment: 0,0:01:42.08,0:01:44.29,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Konaj, żyj, ale wstawaj, no już
Comment: 0,0:01:44.29,0:01:45.84,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Rozpruj świat w strzępy
Comment: 0,0:01:45.84,0:01:48.21,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Pozwól magii zszyć się w całość
Comment: 0,0:00:30.01,0:02:00.02,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,
