Comment: 0,0:23:14.87,0:23:14.87,Znaki,,0,0,0,,OP
Comment: 0,0:02:21.41,0:02:24.25,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Bólem na nowo spisujemy twoje imię
Comment: 0,0:02:24.54,0:02:27.84,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Wracamy do punktu startu, by zacząć od zera
Comment: 0,0:02:27.84,0:02:31.26,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Zagubieni w pustce zakręćmy kołem losu
Comment: 0,0:02:31.26,0:02:33.38,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Niech fortuna się toczy
Comment: 0,0:02:33.38,0:02:34.72,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Znam swoją dolę
Comment: 0,0:02:34.72,0:02:37.80,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Zmienić, przekuć, odbudować, odnowić
Comment: 0,0:02:37.80,0:02:39.72,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Zapisz me imię na kartach historii
Comment: 0,0:02:39.72,0:02:40.97,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Próbuj do skutku
Comment: 0,0:02:41.43,0:02:44.27,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Za tobą skoczę nawet w ogień
Comment: 0,0:02:44.27,0:02:46.35,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Dzierż mnie w dłoni niczym broń
Comment: 0,0:02:46.35,0:02:47.61,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Aż spojrzę w oczy zgubie
Comment: 0,0:02:47.98,0:02:52.94,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Choćbyś w pył obracał się raz za razem
Comment: 0,0:02:52.94,0:02:57.66,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Wyjdź na przekór rozpaczy
Comment: 0,0:02:57.66,0:03:00.12,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Szarpnij za struny swojego życia
Comment: 0,0:03:00.12,0:03:02.62,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Nawet zapomniany przez cały świat
Comment: 0,0:03:02.62,0:03:04.33,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Echo mojego istnienia
Comment: 0,0:03:04.33,0:03:07.17,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Rozbrzmiewa wśród zgliszczy
Comment: 0,0:03:07.17,0:03:11.63,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Serce moim drogowskazem, wiodącym mnie
Comment: 0,0:03:11.63,0:03:13.17,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Zniszcz, spal, a potem scal
Comment: 0,0:03:12.38,0:03:14.17,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Prosto do celu
Comment: 0,0:03:14.17,0:03:15.26,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Zaraz zobaczysz
Comment: 0,0:03:15.26,0:03:17.47,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Aż zrobi ci się mokro
Comment: 0,0:03:17.47,0:03:18.55,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Pora na bis
Comment: 0,0:03:18.55,0:03:20.43,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Stojąc po kolana w piasku
Comment: 0,0:03:20.43,0:03:21.81,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Właśnie teraz
Comment: 0,0:03:21.81,0:03:23.85,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Zawołaj mnie, bo pora na kurtynę
Comment: 0,0:03:23.85,0:03:24.39,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Tylko patrz
Comment: 0,0:03:24.39,0:03:26.06,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Dostaniesz w kość jak nikt inny
Comment: 0,0:03:26.06,0:03:28.27,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Konaj, żyj, ale wstawaj, no już
Comment: 0,0:03:28.27,0:03:29.81,Reweave - Konomi Suzuki feat. Ashnikko [PL],,0,0,0,,Rozpruj świat w strzępy
