Dialogue: 0,0:00:32.85,0:00:38.68,Dialogowa,Jabber,0,0,0,,Nie możemy się tak długo bawić, Zanka.
Dialogue: 0,0:00:45.36,0:00:48.90,Dialogowa,Jabber,0,0,0,,Chodźmy złożyć cię Gruzom w ofierze.
Dialogue: 0,0:00:59.62,0:01:04.67,Dialogowa,Jabber,0,0,0,,Jabber, świetnie się spisałeś!
Dialogue: 0,0:01:12.18,0:01:16.18,Dialogowa,Jabber,0,0,0,,Ciekawe, jaką nagrodę dostanę od szefa?
Dialogue: 0,0:01:29.78,0:01:31.45,Dialogowa,Jabber,0,0,0,,Co jest, kurwa?
Dialogue: 0,0:03:11.55,0:03:12.92,Dialogowa,Fu,0,0,0,,Niedobrze.
Dialogue: 0,0:03:14.09,0:03:20.22,Dialogowa,Fu,0,0,0,,Niedobrze, niedobrze, niedobrze, niedobrze...
Dialogue: 0,0:03:21.10,0:03:24.64,Dialogowa,Fu,0,0,0,,Inni już pewnie kończą swoje walki.
Dialogue: 0,0:03:25.81,0:03:30.48,Dialogowa,Fu,0,0,0,,Też powinienem kończyć. {Todoroki z TEMU}
Dialogue: 0,0:03:30.81,0:03:33.82,Dialogowa,Fu,0,0,0,,Ale jak mam to zrobić?
Dialogue: 0,0:03:34.90,0:03:37.95,Dialogowa,Fu,0,0,0,,Nie wiem jak zacząć walkę. {debil na poziomie Zanki}{Zanka to depresyjny choleryk xD}
Dialogue: 0,0:03:38.95,0:03:41.08,Dialogowa,Fu,0,0,0,,Co mam robić?
Dialogue: 0,0:03:43.49,0:03:45.08,Dialogowa,Fu,0,0,0,,Przepraszam...
Dialogue: 0,0:03:45.08,0:03:48.58,Dialogowa,Fu,0,0,0,,proszę pana.
Dialogue: 0,0:03:48.58,0:03:50.33,Dialogowa,Enjin,0,0,0,,Że co?
Dialogue: 0,0:03:50.33,0:03:52.59,Dialogowa,Fu,0,0,0,,Nazywam się...
Dialogue: 0,0:03:53.09,0:03:54.38,Dialogowa,Fu,0,0,0,,Jak to szło?
Dialogue: 0,0:03:55.17,0:03:58.38,Dialogowa,Fu,0,0,0,,Fu Orostor.
Dialogue: 0,0:03:58.38,0:04:00.64,Dialogowa,Enjin,0,0,0,,Fuj Orostor?
Dialogue: 0,0:04:01.05,0:04:03.68,Dialogowa,Enjin,0,0,0,,Spoko, jestem Enjin.
Dialogue: 0,0:04:09.10,0:04:14.69,Dialogowa,Fu,0,0,0,,Pan Zodyl, mój szef, rozkazał...
Dialogue: 0,0:04:14.69,0:04:20.16,Dialogowa,Fu,0,0,0,,żeby pozostałych przybyłych Sprzątaczy\Nzłożyć w ofierze.
Dialogue: 0,0:04:20.45,0:04:22.12,Myśli,Enjin,0,0,0,,W ofierze? {Enjin patrzy na niego jak ja na klientów w robocie xD}
Dialogue: 0,0:04:22.12,0:04:24.50,Dialogowa,Fu,0,0,0,,Wiem, że dam radę...
Dialogue: 0,0:04:24.79,0:04:28.79,Dialogowa,Fu,0,0,0,,ale miałem skończyć swoją walkę jako pierwszy.
Dialogue: 0,0:04:29.54,0:04:32.25,Dialogowa,Fu,0,0,0,,A jeśli będę ostatni...
Dialogue: 0,0:04:40.13,0:04:44.01,Dialogowa,Fu,0,0,0,,Dlatego jakoś muszę zacząć naszą walkę!
Dialogue: 0,0:04:51.94,0:04:55.86,Dialogowa,Fu,0,0,0,,Mógłby pan mnie uderzyć?
Dialogue: 0,0:05:13.58,0:05:15.09,Dialogowa,Enjin,0,0,0,,Nie.
Dialogue: 0,0:06:14.31,0:06:18.11,Dialogowa,Noerde,0,0,0,,Odepchnęłaś moje włosy podmuchem powietrza,\Nby uniknąć obrażeń?
Dialogue: 0,0:06:18.82,0:06:21.32,Dialogowa,Noerde,0,0,0,,Jak długo dasz radę to ciągnąć?
Dialogue: 0,0:06:39.63,0:06:42.97,Dialogowa,Noerde,0,0,0,,Suko, uciekasz przede mną?
Dialogue: 0,0:06:53.10,0:06:54.69,Dialogowa,Noerde,0,0,0,,Próbujesz mnie wkurwić?
Dialogue: 0,0:06:55.19,0:06:57.02,Dialogowa,Noerde,0,0,0,,Pewnie chcesz się przyczaić
Dialogue: 0,0:06:59.65,0:07:02.99,Dialogowa,Noerde,0,0,0,,i zaatakować z zaskoczenia!
Dialogue: 0,0:07:07.03,0:07:10.20,Dialogowa,Noerde,0,0,0,,Mała żmijo!
Dialogue: 0,0:07:10.87,0:07:13.95,Dialogowa,Noerde,0,0,0,,Gardzę takimi kobietami jak ty!
Dialogue: 0,0:07:14.41,0:07:16.08,Dialogowa,Noerde,0,0,0,,Wyłaź!
Dialogue: 0,0:07:16.12,0:07:20.21,Dialogowa,Noerde,0,0,0,,Też wybrałaś ścieżkę wojowniczki, prawda?
Dialogue: 0,0:07:20.21,0:07:25.38,Dialogowa,Noerde,0,0,0,,Pokaż się i stań do walki!
Dialogue: 0,0:07:26.93,0:07:29.01,Dialogowa,Riyo,0,0,0,,Tak coś właśnie czułam.
Dialogue: 0,0:07:29.01,0:07:31.68,Dialogowa,Riyo,0,0,0,,Nie możesz być wiecznie...
Dialogue: 0,0:07:33.14,0:07:35.93,Dialogowa,Riyo,0,0,0,,pod napięciem, prawda?
Dialogue: 0,0:07:41.65,0:07:42.94,Myśli,Riyo,0,0,0,,Zrobiła unik?
Dialogue: 0,0:08:01.67,0:08:05.55,Dialogowa,Noerde,0,0,0,,Nie myśl sobie, że pozwolę ci znowu ściąć mi włosy.
Dialogue: 0,0:08:06.42,0:08:11.09,Dialogowa,Noerde,0,0,0,,Jak tancerki przyzwyczajają się\Ndo wysokich obcasów i tańczą.,
Dialogue: 0,0:08:11.09,0:08:16.27,Dialogowa,Noerde,0,0,0,,tak ja, długo dbając o moje włosy,\Nnauczyłam się nimi poruszać do woli.
Dialogue: 0,0:08:16.77,0:08:20.15,Dialogowa,Noerde,0,0,0,,Myślisz, że jak długo je zapuszczałam?
Dialogue: 0,0:08:20.15,0:08:21.94,Dialogowa,Noerde,0,0,0,,Nie lekceważ mnie!
Dialogue: 0,0:08:24.44,0:08:26.07,Dialogowa,Riyo,0,0,0,,Jasny gwint.
Dialogue: 0,0:08:27.03,0:08:31.45,Dialogowa,Riyo,0,0,0,,Pierwszy raz spotykam\Nkogoś tak dumnego ze swoich kłaków.
Dialogue: 0,0:08:31.82,0:08:34.33,Dialogowa,Noerde,0,0,0,,Miałaś jednak rację.
Dialogue: 0,0:08:34.87,0:08:39.58,Dialogowa,Noerde,0,0,0,,Elektryczność statyczna, którą wytwarzam,\Njest ograniczona czasowo.
Dialogue: 0,0:08:39.87,0:08:42.46,Dialogowa,Noerde,0,0,0,,Mogę ją swobodnie rozładować,
Dialogue: 0,0:08:42.46,0:08:46.21,Dialogowa,Noerde,0,0,0,,ale nie utrzymam jej dłużej niż dwie minuty.
Dialogue: 0,0:08:47.17,0:08:49.17,Dialogowa,Noerde,0,0,0,,Nie można mieć wszystkiego.
Dialogue: 0,0:08:49.88,0:08:53.10,Dialogowa,Riyo,0,0,0,,Rozumiem, ale ulga.
Dialogue: 0,0:08:53.89,0:08:57.43,Dialogowa,Riyo,0,0,0,,Myślałam, że to wiatr cię ogranicza.
Dialogue: 0,0:08:57.81,0:09:02.52,Dialogowa,Riyo,0,0,0,,Bałam się, że będę musiała wprawić te młyny w ruch.
Dialogue: 0,0:09:03.56,0:09:06.61,Dialogowa,Riyo,0,0,0,,Ale skoro to czas jest twoim ograniczeniem,\N będzie łatwo.
Dialogue: 0,0:09:08.82,0:09:11.28,Dialogowa,Noerde,0,0,0,,Optymistka z ciebie, Riyo.
Dialogue: 0,0:09:11.95,0:09:15.03,Dialogowa,Noerde,0,0,0,,Na twoje nieszczęście znam swoje słabości.
Dialogue: 0,0:09:15.03,0:09:16.99,Dialogowa,Noerde,0,0,0,,Dlatego jestem wojowniczką.
Dialogue: 0,0:09:26.34,0:09:27.84,Myśli,Riyo,0,0,0,,Te ruchy... {kusiło „kocie”, ale za mało gada}
Dialogue: 0,0:09:28.13,0:09:30.47,Dialogowa,Riyo,0,0,0,,Noerde, czym się wcześniej zajmowałaś?
Dialogue: 0,0:09:34.05,0:09:36.93,Dialogowa,Noerde,0,0,0,,Pochodzę z wioski kobiet na południu.
Dialogue: 0,0:09:37.35,0:09:41.89,Dialogowa,Noerde,0,0,0,,Z plenienia wojowniczek Sileia! {przetłumaczyli to u nas na Zylea}{to nawet nie brzmi jak Zylea, wtf xD}
Dialogue: 0,0:09:43.81,0:09:45.98,Dialogowa,Riyo,0,0,0,,Sorki, pierwsze słyszę.
Dialogue: 0,0:09:45.98,0:09:48.48,Dialogowa,Noerde,0,0,0,,Nic dziwnego.
Dialogue: 0,0:09:49.36,0:09:52.65,Dialogowa,Noerde,0,0,0,,Od dawna już nie istnieje!
Dialogue: 0,0:09:59.45,0:10:03.96,Dialogowa,Noerde,0,0,0,,Twój styl walki nie pasuje do broni tego rozmiaru.
Dialogue: 0,0:10:08.25,0:10:10.84,Dialogowa,Riyo,0,0,0,,Wręcz przeciwnie.
Dialogue: 0,0:10:11.76,0:10:15.18,Dialogowa,Riyo,0,0,0,,Ale zdradzę ci sekret.
Dialogue: 0,0:10:16.22,0:10:20.18,Dialogowa,Riyo,0,0,0,,Świetnie walczę jeden na jednego.
Dialogue: 0,0:10:23.69,0:10:25.73,Dialogowa,Noerde,0,0,0,,Kim ty, do diabła, jesteś?
Dialogue: 0,0:10:26.61,0:10:28.07,Dialogowa,Riyo,0,0,0,,Riyo, przecież mówiłam.{widziałam wiele karykaturalnie narysowanych postaci, ale rudą to rysuje jakiś ziemniak z kutasem zamiast mózgu, laska wygląda jak chodząca anoreksja, a ten jej cycki dorysowuje. Co to za biodra są, wtf}
Dialogue: 0,0:13:02.59,0:13:05.10,Dialogowa,Noerde,0,0,0,,Potrafisz trochę podrapać.
Dialogue: 0,0:13:09.35,0:13:10.35,Dialogowa,Noerde,0,0,0,,Jednak...
Dialogue: 0,0:13:11.69,0:13:14.36,Dialogowa,Noerde,0,0,0,,Nie mocniej, niż zwykły kociak.
Dialogue: 0,0:13:20.74,0:13:22.11,Dialogowa,Riyo,0,0,0,,W sumie.
Dialogue: 0,0:13:22.36,0:13:25.99,Dialogowa,Riyo,0,0,0,,Nikt tu nie usłyszy, jak wołam o pomoc, prawda?
Dialogue: 0,0:13:26.41,0:13:30.21,Dialogowa,Noerde,0,0,0,,Zgadza się, zostałaś sama.
Dialogue: 0,0:13:31.08,0:13:32.67,Dialogowa,Riyo,0,0,0,,Rozumiem.
Dialogue: 0,0:13:33.92,0:13:36.34,Dialogowa,Riyo,0,0,0,,Czyli nie będzie go słychać.
Dialogue: 0,0:13:37.50,0:13:40.55,Dialogowa,Noerde,0,0,0,,Bez obaw, zaraz skończę.
Dialogue: 0,0:13:40.84,0:13:43.51,Dialogowa,Noerde,0,0,0,,Trafisz na ołtarz razem z kolegami.
Dialogue: 0,0:13:46.14,0:13:47.43,Dialogowa,Noerde,0,0,0,,Co? {no rudym pizdom się nie ufa, prawda stara jak świat}
Dialogue: 0,0:14:35.02,0:14:36.40,Dialogowa,Noerde,0,0,0,,Skąd...
Dialogue: 0,0:14:36.98,0:14:39.36,Dialogowa,Noerde,0,0,0,,Skąd to masz?
Dialogue: 0,0:14:40.69,0:14:44.78,Dialogowa,Riyo,0,0,0,,Enjin surowo zabrania zabijać.
Dialogue: 0,0:14:45.66,0:14:49.16,Dialogowa,Riyo,0,0,0,,Próbowałam tego uniknąć, jasne?
Dialogue: 0,0:14:49.70,0:14:53.46,Dialogowa,Riyo,0,0,0,,Jesteś za mocna i nie miałam wyjścia.
Dialogue: 0,0:14:54.87,0:14:57.88,Dialogowa,Riyo,0,0,0,,Na szczęście nikt tego nie usłyszy.
Dialogue: 0,0:14:58.13,0:15:00.50,Dialogowa,Riyo,0,0,0,,Chcę to jak najszybciej zakończyć.
Dialogue: 0,0:15:01.92,0:15:05.80,Dialogowa,Riyo,0,0,0,,Muszę pomóc przyjaciołom.
Dialogue: 0,0:15:08.01,0:15:12.31,Dialogowa,Riyo,0,0,0,,Nie martw się, moim Meritum są tamte nożyczki.
Dialogue: 0,0:15:12.31,0:15:15.89,Dialogowa,Riyo,0,0,0,,Nigdy nie splamię ich krwią.
Dialogue: 0,0:15:16.44,0:15:18.81,Dialogowa,Riyo,0,0,0,,Przysięgałam tak dawno temu.
Dialogue: 0,0:15:19.56,0:15:22.78,Dialogowa,Riyo,0,0,0,,Pistolet dostałam od poprzedniego szefa.
Dialogue: 0,0:15:23.44,0:15:25.28,Dialogowa,Riyo,0,0,0,,Jako prezent.
Dialogue: 0,0:15:25.82,0:15:27.74,Dialogowa,Noerde,0,0,0,,Byłaś kiedyś...
Dialogue: 0,0:15:28.70,0:15:30.33,Dialogowa,Noerde,0,0,0,,zabójczynią?!
Dialogue: 0,0:15:38.88,0:15:43.09,Dialogowa,Riyo,0,0,0,,Zostanie to między nami, dobrze?
Dialogue: 0,0:15:44.21,0:15:48.47,Dialogowa,Riyo,0,0,0,,Masz szczęście, że podlegam teraz pod Enjina.{Zanka podlega bardziej, bo to simp}
Dialogue: 0,0:15:48.47,0:15:50.43,Dialogowa,Riyo,0,0,0,,Daruję ci życie.
Dialogue: 0,0:15:51.22,0:15:54.39,Dialogowa,Riyo,0,0,0,,Nie celowałam w kluczowe organy,\Nale sama stąd nie wyjdziesz.
Dialogue: 0,0:15:54.39,0:15:57.23,Dialogowa,Riyo,0,0,0,,Będziesz potrzebowała pomocy\Ndziewczyny ze studzienką.
Dialogue: 0,0:15:59.48,0:16:03.32,Dialogowa,Riyo,0,0,0,,Ja w tym czasie poszukam swoich przyjaciół.
Dialogue: 0,0:16:07.65,0:16:09.95,Dialogowa,Riyo,0,0,0,,Wiesz, gdzie ich znajdę, prawda?
Dialogue: 0,0:16:13.66,0:16:18.79,Myśli,Noerde,0,0,0,,Popełniłam błąd,\Nuznając Sprzątaczy za nieskazitelnych.
Dialogue: 0,0:16:23.55,0:16:26.51,Myśli,Noerde,0,0,0,,Oni też skrywają brudy.
Dialogue: 0,0:16:30.14,0:16:36.10,Dialogowa,Riyo,0,0,0,,Wiedziała tylko, gdzie jest\Nta od studzienki i ich szef.
Dialogue: 0,0:16:37.35,0:16:41.23,Dialogowa,Riyo,0,0,0,,Mówiła, że rury łączą się \Njak żyły.
Dialogue: 0,0:16:41.56,0:16:44.11,Dialogowa,Riyo,0,0,0,,Szykuje się upierdliwa przeprawa.
Dialogue: 0,0:17:03.17,0:17:06.13,Dialogowa,Riyo,0,0,0,,Chciałabym cię lepiej poznać.{ep 4}
Dialogue: 0,0:17:06.13,0:17:07.21,Dialogowa,Riyo,0,0,0,,Jasne?{ep 4}
Dialogue: 0,0:17:10.13,0:17:13.14,Dialogowa,Riyo,0,0,0,,Wciąż nie wiem, jak potoczą się sprawy z Rudo.
Dialogue: 0,0:17:24.31,0:17:25.48,Dialogowa,Riyo,0,0,0,,Ale...
Dialogue: 0,0:17:34.66,0:17:35.74,Dialogowa,Riyo,0,0,0,,Enjin. {ep 10}
Dialogue: 0,0:17:36.37,0:17:40.12,Dialogowa,Riyo,0,0,0,,Może na wszelki wypadek ja pójdę ją wypytać? {ep 10}
Dialogue: 0,0:17:41.21,0:17:46.92,Dialogowa,Rudo,0,0,0,,I wtedy spróbujemy poznać się nawzajem. {ep 13}
Dialogue: 0,0:17:53.68,0:17:56.60,Dialogowa,Riyo,0,0,0,,Powinniśmy zostawić ją samą...
Dialogue: 0,0:18:01.39,0:18:03.31,Dialogowa,Jabber,0,0,0,,Co jest, kurwa?
Dialogue: 0,0:18:21.08,0:18:24.54,Dialogowa,Riyo,0,0,0,,Twardy z ciebie drań, więc pewnie nie zdechniesz.
Dialogue: 0,0:18:30.38,0:18:33.47,Dialogowa,Riyo,0,0,0,,Zanka, żyjesz?
Dialogue: 0,0:18:35.30,0:18:37.26,Dialogowa,Riyo,0,0,0,,Wstawaj.
Dialogue: 0,0:18:38.47,0:18:42.23,Dialogowa,Riyo,0,0,0,,Jednak żyjesz, to dobrze.
Dialogue: 0,0:18:42.23,0:18:45.19,Dialogowa,Riyo,0,0,0,,Widzę, że nieźle cię przegrzmocił.
Dialogue: 0,0:18:46.40,0:18:49.15,Dialogowa,Riyo,0,0,0,,Lepiej się stąd zmywajmy.
Dialogue: 0,0:18:54.99,0:18:58.16,Dialogowa,Riyo,0,0,0,,Trzeba postawić cię na nogi.
Dialogue: 0,0:19:15.80,0:19:17.43,Dialogowa,Cthoni,0,0,0,,Jabber wygrał.{...ja bym z nim mogła wszystko zrzucać, nie tylko Sferę :>}
Dialogue: 0,0:19:18.14,0:19:19.97,Dialogowa,Cthoni,0,0,0,,Noerde przegrała.
Dialogue: 0,0:19:19.97,0:19:25.06,Dialogowa,Cthoni,0,0,0,,Fu nadal czeka,\Naż ten z parasolem wykona pierwszy ruch.
Dialogue: 0,0:19:26.06,0:19:31.98,Dialogowa,Cthoni,0,0,0,,Bundus rozmawia z duetem ojciec-syn,\Nwypytując ich o przywódcę Sprzątaczy.
Dialogue: 0,0:19:33.57,0:19:34.78,Dialogowa,Zodyl,0,0,0,,Rudo.
Dialogue: 0,0:19:36.11,0:19:39.37,Dialogowa,Zodyl,0,0,0,,Sprzątacze okazali się twardsi niż sądziłem.
Dialogue: 0,0:19:39.37,0:19:40.87,Dialogowa,Rudo,0,0,0,,O czym ty pierdolisz?
Dialogue: 0,0:19:40.87,0:19:42.87,Dialogowa,Rudo,0,0,0,,Co z nimi?
Dialogue: 0,0:19:43.20,0:19:45.00,Dialogowa,Zodyl,0,0,0,,Musimy się pospieszyć.
Dialogue: 0,0:20:07.39,0:20:09.81,Dialogowa,Rudo,0,0,0,,Niech cię szlag.
Dialogue: 0,0:20:09.81,0:20:12.36,Dialogowa,Rudo,0,0,0,,Przestańcie przestawiać mnie z kąta w kąt.
Dialogue: 0,0:20:12.36,0:20:16.15,Dialogowa,Rudo,0,0,0,,Co to za miejsce?
Dialogue: 0,0:20:16.15,0:20:18.66,Dialogowa,Rudo,0,0,0,,Na chuj mnie tu ściągnęliście?
Dialogue: 0,0:20:19.57,0:20:21.99,Dialogowa,Rudo,0,0,0,,Zajebię was za to!
Dialogue: 0,0:20:21.99,0:20:26.45,Dialogowa,Zodyl,0,0,0,,Nie potrafisz się uspokoić bez krzyków,\Ngróźb i przekleństw, prawda?
Dialogue: 0,0:20:27.29,0:20:29.96,Dialogowa,Zodyl,0,0,0,,Złożyłem ci propozycję.
Dialogue: 0,0:20:29.96,0:20:33.13,Dialogowa,Zodyl,0,0,0,,Byśmy wspólnie strącili Sferę.
Dialogue: 0,0:20:34.21,0:20:37.88,Dialogowa,Zodyl,0,0,0,,Nie marnuj energii na zdzieranie gardła.
Dialogue: 0,0:20:38.51,0:20:42.55,Dialogowa,Zodyl,0,0,0,,Tylko dobrze zastanów się nad odpowiedzią.
Dialogue: 0,0:20:44.10,0:20:48.60,Dialogowa,Zodyl,0,0,0,,Chyba że muszę ci przeliterować jak dziecku?
Dialogue: 0,0:20:49.94,0:20:52.48,Dialogowa,Zodyl,0,0,0,,A może wolisz obrazki?
Dialogue: 0,0:20:53.82,0:20:57.28,Dialogowa,Rudo,0,0,0,,Nie musisz się wysilać, wiem o co ci chodzi!
Dialogue: 0,0:20:58.44,0:21:00.82,Dialogowa,Rudo,0,0,0,,Jesteś najgorszym z dupków!
Dialogue: 0,0:21:04.08,0:21:08.29,Dialogowa,Zodyl,0,0,0,,Szkoda, że nie spadł nam bardziej ogarnięty Sferyta.
Dialogue: 0,0:21:14.88,0:21:18.97,Dialogowa,Zodyl,0,0,0,,Nawet gdybym wyjaśnił, jaki mam plan\Ni tak byś mnie odrzucił, prawda?
Dialogue: 0,0:21:20.51,0:21:23.09,Dialogowa,Zodyl,0,0,0,,W takim razie ci pokażę.
Dialogue: 0,0:21:41.49,0:21:44.12,Dialogowa,Zodyl,0,0,0,,Kolekcja Wartownika.
Dialogue: 0,0:21:47.74,0:21:49.83,Dialogowa,Zodyl,0,0,0,,Twoje rękawice.
Dialogue: 0,0:21:50.71,0:21:52.50,Dialogowa,Zodyl,0,0,0,,Mój płaszcz.
Dialogue: 0,0:21:53.54,0:21:56.00,Dialogowa,Zodyl,0,0,0,,I te buty.
Dialogue: 0,0:21:57.96,0:22:03.30,Dialogowa,Zodyl,0,0,0,,Próbowałem rozszerzyć ją o nowe przedmioty.
Comment: 0,0:22:03.30,0:22:07.30,Znaki,Zodyl,0,0,0,,
