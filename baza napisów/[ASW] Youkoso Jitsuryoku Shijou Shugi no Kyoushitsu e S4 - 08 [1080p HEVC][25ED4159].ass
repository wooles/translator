Comment: 0,0:00:54.08,0:00:56.08,MONSTER -  Eir Aoi [PL],,0,0,0,,OP
Comment: 0,0:00:36.02,0:00:40.98,MONSTER -  Eir Aoi [PL],,0,0,0,,Spuszczone ze smyczy monstrum
Comment: 0,0:00:37.60,0:00:40.98,MONSTER -  Eir Aoi [PL] 2,,0,0,0,,Już się na was czai
Comment: 0,0:00:40.98,0:00:42.48,MONSTER -  Eir Aoi [PL] 2,,0,0,0,,Zakrada się
Comment: 0,0:00:44.23,0:00:47.07,MONSTER -  Eir Aoi [PL],,0,0,0,,Spieprzajcie, gdzie pieprz rośnie
Comment: 0,0:00:47.49,0:00:50.07,MONSTER -  Eir Aoi [PL],,0,0,0,,Raz, dwa, trzy, baba jaga patrzy
Comment: 0,0:00:50.95,0:00:54.08,MONSTER -  Eir Aoi [PL],,0,0,0,,Oświecisz mnie, kim jest geniusz?
Comment: 0,0:00:54.08,0:00:57.58,MONSTER -  Eir Aoi [PL],,0,0,0,,To ktoś, kto nagina rzeczywistość
Comment: 0,0:00:57.58,0:01:00.46,MONSTER -  Eir Aoi [PL],,0,0,0,,Nie dokarmiajcie bestii
Comment: 0,0:01:00.46,0:01:06.63,MONSTER -  Eir Aoi [PL],,0,0,0,,Jeśli wam ręce miłe
Comment: 0,0:01:07.05,0:01:10.51,MONSTER -  Eir Aoi [PL],,0,0,0,,Każdy jest tylko pionkiem w rękach króla
Comment: 0,0:01:10.51,0:01:13.64,MONSTER -  Eir Aoi [PL],,0,0,0,,Już się czai
Comment: 0,0:01:13.68,0:01:16.89,MONSTER -  Eir Aoi [PL],,0,0,0,,I jak ci się podoba wizja przyszłości?
Comment: 0,0:01:16.89,0:01:21.35,MONSTER -  Eir Aoi [PL],,0,0,0,,Monstrum utkane ze steku kłamstw
Comment: 0,0:01:21.35,0:01:23.44,MONSTER -  Eir Aoi [PL],,0,0,0,,Potwór się czai i czai
Comment: 0,0:01:23.44,0:01:25.48,MONSTER -  Eir Aoi [PL],,0,0,0,,Dorwijcie w końcu go
Comment: 0,0:01:25.48,0:01:28.61,MONSTER -  Eir Aoi [PL],,0,0,0,,Pociągnijcie za ten zdradliwy spust
Comment: 0,0:01:28.61,0:01:29.90,MONSTER -  Eir Aoi [PL],,0,0,0,,Wciąż się czai i czai
Comment: 0,0:01:29.90,0:01:32.11,MONSTER -  Eir Aoi [PL],,0,0,0,,A wy się topicie
Comment: 0,0:01:32.11,0:01:33.87,MONSTER -  Eir Aoi [PL],,0,0,0,,W labiryncie myśli
Comment: 0,0:01:33.87,0:01:35.37,MONSTER -  Eir Aoi [PL],,0,0,0,,Otoczeni zagadkami
Comment: 0,0:01:35.37,0:01:40.46,MONSTER -  Eir Aoi [PL],,0,0,0,,W świecie prawdy i fałszu będziesz łowcą czy zwierzyną?
Comment: 0,0:01:40.46,0:01:41.75,MONSTER -  Eir Aoi [PL],,0,0,0,,Czas nagli
Comment: 0,0:01:41.75,0:01:43.17,MONSTER -  Eir Aoi [PL],,0,0,0,,Chowa się i kryje
Comment: 0,0:01:43.17,0:01:44.96,MONSTER -  Eir Aoi [PL],,0,0,0,,Pragnąc jedynie spokoju
Comment: 0,0:01:44.96,0:01:46.42,MONSTER -  Eir Aoi [PL],,0,0,0,,Czai się i czai
Comment: 0,0:01:46.42,0:01:50.97,MONSTER -  Eir Aoi [PL],,0,0,0,,O tak, nieobliczalne monstrum
Comment: 0,0:01:48.38,0:01:51.55,MONSTER -  Eir Aoi [PL] 2,,0,0,0,,Pałka, zapałka, dwa kije
Comment: 0,0:01:51.59,0:01:54.18,MONSTER -  Eir Aoi [PL] 2,,0,0,0,,Kto się nie schowa, ten kryje
