# Twój klucz API Google Gemini (z https://aistudio.google.com/)
GEMINI_API_KEY=twoj_klucz_api_tutaj

# Model z dużym darmowym limitem: 500 zapytań dziennie i 15 RPM
GEMINI_MODEL=gemini-3.5-flash-lite

# Liczba kwestii dialogowych w jednej paczce (rekomendowane: 14)
BATCH_SIZE=14

# Weryfikator i dedykowany Redaktor Dialogów (Faza 2)
ENABLE_VERIFIER=true

# Czy zachowywać japońskie honoryfikatory (-kun, -chan, -san, -sama)?
# true  = ZACHOWAJ przyrostki przy imionach (np. Minami-kun, Akaishi-san) - styl fansub
# false = USUŃ przyrostki i zastąp czystą polszczyzną (np. Minami, Akaishi) - styl dubbing/Netflix
KEEP_HONORIFICS=true

# Maksymalna szerokość klatki wideo wysyłanej do analizy wizualnej
MAX_IMAGE_WIDTH=540
